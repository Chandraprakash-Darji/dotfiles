{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Right Command → Hyper (✦ = ⌘⌃⌥⇧)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_control", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "✦O → Open Camera (Raycast)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "o",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open 'raycast-x://extensions/raycast/raycast/open-camera'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "✦P → Pick Color (Raycast)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "p",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open 'raycast-x://extensions/thomas/color-picker/pick-color'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⌘⇧L → Lock screen",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "l",
                                    "modifiers": { "mandatory": ["command", "shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "q",
                                        "modifiers": ["left_control", "left_command"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⌘E → Open Finder",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "e",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [{ "shell_command": "open ~" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⇧⌘V → Clipboard History (Raycast)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["command", "shift"] }
                                },
                                "to": [{ "shell_command": "open 'raycast://extensions/raycast/clipboard-history/clipboard-history'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⌥N → Raycast Notes",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "n",
                                    "modifiers": { "mandatory": ["option"] }
                                },
                                "to": [{ "shell_command": "open 'raycast://extensions/raycast/raycast-notes/raycast-notes'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⌥D → Open Downloads",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "d",
                                    "modifiers": { "mandatory": ["option"] }
                                },
                                "to": [{ "shell_command": "open ~/Downloads" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "✦C → Confetti (Raycast)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open 'raycast-x://extensions/raycast/raycast/confetti'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⌥S → Open Slack",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "s",
                                    "modifiers": { "mandatory": ["option"] }
                                },
                                "to": [{ "shell_command": "open -a 'Slack'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "✦N → New timestamped note in Neovim (Ghostty)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "n",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                                },
                                "to": [{ "shell_command": "mkdir -p ~/Desktop/p/notes && open -na Ghostty --args -e /opt/homebrew/bin/nvim ~/Desktop/p/notes/$(date +%d-%m-%Y-%H-%M).md" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "✦E → Open elregaldo.com portfolio in VSCode",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "e",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Visual Studio Code' ~/ghq/github.com/Chandraprakash-Darji/portfolio" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": { "key_code": "caps_lock" },
                    "to": [{ "key_code": "left_control" }]
                }
            ],
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}