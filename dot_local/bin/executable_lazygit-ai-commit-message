#!/usr/bin/env bash
set -euo pipefail

if ! command -v opencode >/dev/null 2>&1; then
    printf 'OpenCode CLI was not found in PATH.\n' >&2
    exit 1
fi

if ! command -v pbcopy >/dev/null 2>&1; then
    printf 'pbcopy is required to copy the generated commit subject.\n' >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf 'Current directory is not inside a Git repository.\n' >&2
    exit 1
}
cd "$repo_root"

if git diff --cached --quiet --; then
    printf 'No staged changes. Stage the changes to include in the commit, then try again.\n' >&2
    exit 1
fi

diff_file=$(mktemp "${TMPDIR:-/tmp}/lazygit-staged-diff.XXXXXX")
response_file=$(mktemp "${TMPDIR:-/tmp}/lazygit-ai-message.XXXXXX")
trap 'rm -f "$diff_file" "$response_file"' EXIT

git diff --cached --no-ext-diff --unified=3 > "$diff_file"

if ! opencode run --model meta/muse-spark-1.3-contributor --file "$diff_file" \
    "Create one concise Conventional Commit subject for the staged changes in the attached diff. Use the format type(scope): description, using a standard type such as feat, fix, docs, refactor, test, build, ci, perf, or chore. Use imperative wording, keep the full subject around 72 characters or fewer, and add a scope only when useful. Output only the subject line, with no quotes, Markdown, or explanation. Do not modify files or run commands." \
    > "$response_file"; then
    printf 'OpenCode could not generate a commit subject.\n' >&2
    cat "$response_file" >&2
    exit 1
fi

message=$(awk 'NF { sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); print; exit }' "$response_file")
if [[ -z "$message" ]]; then
    printf 'OpenCode returned an empty commit subject.\n' >&2
    exit 1
fi

printf '%s' "$message" | pbcopy
printf 'Suggested commit subject (copied to clipboard):\n\n%s\n\nReturn to LazyGit, open the commit prompt, paste, review, and commit when ready.\n' "$message"
